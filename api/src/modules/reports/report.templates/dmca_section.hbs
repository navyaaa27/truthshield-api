<div class="page dmca-section-page" style="page-break-before: always; box-sizing: border-box; padding: 20mm 15mm; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; background: #ffffff;">
  
  <h2 style="font-size: 22px; font-weight: 800; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-top: 0; margin-bottom: 20px; color: #0f172a; display: flex; justify-content: space-between; align-items: center;">
    <span>IP Infringement DMCA Notices</span>
    <span style="font-size: 11px; background: #f1f5f9; color: #475569; padding: 3px 10px; border-radius: 20px; font-weight: 500;">Section DMCA</span>
  </h2>

  {{#if dmcaDrafts.length}}
    {{#each dmcaDrafts}}
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 30px; overflow: hidden; page-break-inside: avoid;">
        <!-- Header details -->
        <div style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span style="font-size: 9px; color: #64748b; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">Original Asset Focus</span>
            <strong style="font-size: 12px; color: #0f172a;">{{originalAssetDescription}}</strong>
          </div>
          <div style="text-align: right;">
            <span style="font-size: 9px; color: #64748b; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">Similarity Match</span>
            <span style="font-size: 12px; font-weight: 800; color: #b91c1c;">{{similarityScore}}% ({{matchType}})</span>
          </div>
        </div>

        <div style="padding: 20px;">
          <!-- Infringing URL info -->
          <div style="font-size: 12px; color: #334155; margin-bottom: 15px;">
            <strong>Infringing Resource URL:</strong> 
            <a href="{{infringingUrl}}" style="color: #0284c7; text-decoration: none; word-break: break-all; font-family: monospace;">{{infringingUrl}}</a>
          </div>

          <!-- Formal DMCA Notice Template Draft -->
          <div style="background: #fafafa; border: 1px solid #e2e8f0; border-radius: 6px; padding: 20px; font-family: monospace; font-size: 11px; color: #1e293b; line-height: 1.5; white-space: pre-wrap; margin-bottom: 15px; max-height: 350px; overflow-y: auto;">
            {{dmcaNoticeText}}
          </div>

          <!-- Alert/Disclaimers -->
          <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 6px; padding: 12px 15px; font-size: 11px; color: #991b1b; line-height: 1.4;">
            <strong>Legal Notice Disclaimer:</strong> 
            This document is an automated draft generated for reference. Prior to submitting this DMCA Takedown Notice to any host, registrar, or content platform, it must undergo formal review and authorization by qualified legal counsel representing your organization.
          </div>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div style="text-align: center; padding: 40px; border: 1px dashed #cbd5e1; border-radius: 8px; color: #64748b; font-size: 14px;">
      No intellectual property stolen content matches or DMCA drafts were compiled in this audit period.
    </div>
  {{/if}}
</div>

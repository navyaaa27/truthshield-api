<div class="page cover-page" style="position: relative; height: 297mm; box-sizing: border-box; padding: 40mm 20mm; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; background: #ffffff; overflow: hidden;">
  <!-- CONFIDENTIAL Watermark Overlay -->
  <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; transform: rotate(-45deg); pointer-events: none; z-index: 1; opacity: 0.04; font-size: 80px; font-weight: 900; color: #000; letter-spacing: 10px;">
    CONFIDENTIAL
  </div>

  <div style="z-index: 2; position: relative; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
    <!-- Header Logo & Branding -->
    <div>
      <div style="display: flex; align-items: center; margin-bottom: 30mm;">
        <!-- TruthShield Base64 Logo Placeholder/SVG -->
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 15px;">
          <rect width="48" height="48" rx="12" fill="#0f172a"/>
          <path d="M24 12L34 16.5V25.5C34 31.2 30.1 36.4 24 38C17.9 36.4 14 31.2 14 25.5V16.5L24 12Z" fill="#38bdf8"/>
          <path d="M21.5 26.5L19 24L17.5 25.5L21.5 29.5L30.5 20.5L29 19L21.5 26.5Z" fill="#ffffff"/>
        </svg>
        <div>
          <div style="font-size: 22px; font-weight: 800; letter-spacing: 0.5px; color: #0f172a;">TRUTHSHIELD AI</div>
          <div style="font-size: 10px; font-weight: 600; color: #64748b; letter-spacing: 2px;">CONTENT INTEGRITY SUITE</div>
        </div>
      </div>

      <!-- Report Title Section -->
      <div style="border-left: 6px solid #0284c7; padding-left: 25px; margin-bottom: 20mm;">
        <h1 style="font-size: 38px; font-weight: 800; line-height: 1.15; color: #0f172a; margin: 0 0 10px 0; letter-spacing: -0.5px;">
          {{#if (eq reportType "threat_summary")}}Executive Threat Summary{{/if}}
          {{#if (eq reportType "job_detail")}}Detailed Detection Report{{/if}}
          {{#if (eq reportType "compliance_audit")}}Compliance Audit Report{{/if}}
          {{#if (eq reportType "dmca_bundle")}}Intellectual Property DMCA Bundle{{/if}}
        </h1>
        <p style="font-size: 16px; color: #475569; margin: 0; font-weight: 500;">
          Legal & Compliance Audit Documentation
        </p>
      </div>
    </div>

    <!-- Metadata Footer Section -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 25px; margin-bottom: 10mm;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; font-size: 13px;">
        <div>
          <span style="color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 10px; display: block; margin-bottom: 4px;">Target Organization</span>
          <strong style="color: #0f172a; font-size: 15px;">{{org.name}}</strong>
        </div>
        <div>
          <span style="color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 10px; display: block; margin-bottom: 4px;">Audit Period</span>
          <strong style="color: #0f172a; font-size: 15px;">{{dateRange.startDate}} &mdash; {{dateRange.endDate}}</strong>
        </div>
        <div>
          <span style="color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 10px; display: block; margin-bottom: 4px;">Generated By</span>
          <span style="color: #334155; font-weight: 500;">{{generatedBy.email}}</span>
        </div>
        <div>
          <span style="color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 10px; display: block; margin-bottom: 4px;">Report Identifier</span>
          <span style="color: #334155; font-family: monospace; font-size: 12px;">{{reportId}}</span>
        </div>
      </div>
      <div style="margin-top: 20px; padding-top: 15px; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #64748b;">
        <span>Published: {{generatedAt}}</span>
        <span style="background: #ef4444; color: #ffffff; padding: 2px 8px; border-radius: 4px; font-weight: 700; font-size: 9px; letter-spacing: 1px;">HIGH SECURE</span>
      </div>
    </div>
  </div>
</div>

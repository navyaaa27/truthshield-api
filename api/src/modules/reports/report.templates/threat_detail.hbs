<div class="page threat-detail-page" style="page-break-before: always; box-sizing: border-box; padding: 20mm 15mm; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; background: #ffffff;">
  
  <h2 style="font-size: 22px; font-weight: 800; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px; margin-top: 0; margin-bottom: 20px; color: #0f172a; display: flex; justify-content: space-between; align-items: center;">
    <span>Analytical Threat Feed & Detail Log</span>
    <span style="font-size: 11px; background: #f1f5f9; color: #475569; padding: 3px 10px; border-radius: 20px; font-weight: 500;">Section 2</span>
  </h2>

  {{#if jobs.length}}
    {{#each jobs}}
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 30px; overflow: hidden; page-break-inside: avoid;">
        <!-- Header Info Bar -->
        <div style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center;">
          <div>
            <span style="font-size: 9px; color: #64748b; font-weight: 700; text-transform: uppercase; display: block; margin-bottom: 2px;">Job Identifier</span>
            <span style="font-family: monospace; font-size: 13px; font-weight: 700; color: #0f172a;">{{job_id}}</span>
          </div>
          <div style="display: flex; align-items: center; gap: 10px;">
            <!-- Content Type Badge -->
            <span style="font-size: 9px; font-weight: 700; text-transform: uppercase; background: #e0f2fe; color: #0369a1; padding: 4px 10px; border-radius: 12px;">
              {{content_type}}
            </span>
            <!-- Risk Level Badge -->
            <span style="font-size: 9px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 12px;
              {{#if (eq risk_level "high")}}background: #fee2e2; color: #b91c1c;{{/if}}
              {{#if (eq risk_level "medium")}}background: #fef9c3; color: #a16207;{{/if}}
              {{#if (eq risk_level "low")}}background: #f0fdf4; color: #166534;{{/if}}
              {{#if (eq risk_level "none")}}background: #f1f5f9; color: #475569;{{/if}}">
              {{risk_level}} Risk
            </span>
          </div>
        </div>

        <div style="padding: 20px;">
          <!-- Module Results Table -->
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px; margin-bottom: 15px;">
            <thead>
              <tr style="background: #f1f5f9; color: #475569; font-weight: 600; text-transform: uppercase; font-size: 9px;">
                <th style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0;">Module</th>
                <th style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0; text-align: center;">Score</th>
                <th style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0;">Verdict</th>
                <th style="padding: 8px 12px; border-bottom: 1px solid #e2e8f0; text-align: center;">Status Alerts</th>
              </tr>
            </thead>
            <tbody>
              {{#each module_results}}
                <tr style="border-bottom: 1px solid #f1f5f9;">
                  <td style="padding: 8px 12px; font-weight: 700; color: #334155; text-transform: capitalize;">{{module}}</td>
                  <td style="padding: 8px 12px; text-align: center; font-weight: 700; color: {{#if (gt score 50)}}#ef4444{{else}}#22c55e{{/if}};">{{score}}%</td>
                  <td style="padding: 8px 12px; text-transform: capitalize;">
                    <span style="font-weight: 600;
                      {{#if (eq verdict "manipulated")}}color: #ef4444;{{/if}}
                      {{#if (eq verdict "requires_review")}}color: #f59e0b;{{/if}}
                      {{#if (eq verdict "clean")}}color: #10b981;{{/if}}">
                      {{verdict}}
                    </span>
                  </td>
                  <td style="padding: 8px 12px; text-align: center;">
                    {{#if (gt score 50)}}
                      <span style="display: inline-block; width: 6px; height: 6px; background: #ef4444; border-radius: 50%; margin-right: 4px;"></span>
                      <strong style="color: #b91c1c; font-size: 10px;">FLAGGED</strong>
                    {{else}}
                      <span style="display: inline-block; width: 6px; height: 6px; background: #22c55e; border-radius: 50%; margin-right: 4px;"></span>
                      <span style="color: #166534; font-size: 10px;">PASSED</span>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>

          <!-- Key Findings Bullet List -->
          <div style="background: #f8fafc; border-radius: 6px; padding: 12px 15px;">
            <strong style="font-size: 11px; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 8px;">System Integrity Insights</strong>
            <ul style="margin: 0; padding-left: 20px; font-size: 12px; color: #475569; line-height: 1.5;">
              <li>Analyzed content via core model networks. Overall score: <strong>{{overall_score}}%</strong>.</li>
              {{#if (eq verdict "manipulated")}}
                <li style="color: #b91c1c;"><strong>Critical Finding:</strong> Content is highly likely manipulated. Immediate verification required.</li>
              {{/if}}
              {{#if (eq verdict "requires_review")}}
                <li style="color: #a16207;"><strong>Warning:</strong> Detection triggers fallback review threshold. Human-in-the-loop review pending.</li>
              {{/if}}
              {{#if (eq verdict "clean")}}
                <li style="color: #166534;"><strong>Integrity Confirmed:</strong> Content matched primary control sets. Verdict: CLEAN.</li>
              {{/if}}
              {{#if alert_id}}
                <li>Active System Alert <strong>{{alert_id}}</strong> (Severity: <strong>{{alert_severity}}</strong>) was automatically registered.</li>
              {{/if}}
              {{#if review_id}}
                <li>A manual review override task was scheduled under ticket <strong>{{review_id}}</strong>.</li>
              {{/if}}
            </ul>
          </div>
        </div>
      </div>
    {{/each}}
  {{else}}
    <div style="text-align: center; padding: 40px; border: 1px dashed #cbd5e1; border-radius: 8px; color: #64748b; font-size: 14px;">
      No detection logs matching specified filters or job identifiers were found in the audit period.
    </div>
  {{/if}}
</div>

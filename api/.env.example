NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthshield?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ISSUER=TruthShieldAI

# AWS S3 Storage Configs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRY=3600
MAX_FILE_SIZE_IMAGE_MB=50
MAX_FILE_SIZE_VIDEO_MB=500

# Queue Configurations
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
BULL_BOARD_ENABLED=true
ADMIN_SECRET=admin-secret-key-12345

# Alert & Notification Service Configurations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@truthshield.ai
SLACK_WEBHOOK_URL=
ALERT_SCORE_THRESHOLD_LOW=25
ALERT_SCORE_THRESHOLD_MEDIUM=50
ALERT_SCORE_THRESHOLD_HIGH=75
ALERT_SCORE_THRESHOLD_CRITICAL=90


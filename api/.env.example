NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthshield?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ISSUER=TruthShieldAI

# AWS S3 Storage Configs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRY=3600
MAX_FILE_SIZE_IMAGE_MB=50
MAX_FILE_SIZE_VIDEO_MB=500

# Queue Configurations
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
BULL_BOARD_ENABLED=true
ADMIN_SECRET=admin-secret-key-12345

# Alert & Notification Service Configurations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@truthshield.ai
SLACK_WEBHOOK_URL=
ALERT_SCORE_THRESHOLD_LOW=25
ALERT_SCORE_THRESHOLD_MEDIUM=50
ALERT_SCORE_THRESHOLD_HIGH=75
ALERT_SCORE_THRESHOLD_CRITICAL=90

# Fake News & Misinformation Detection Module
ANTHROPIC_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_API_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
NEWS_CREDIBILITY_THRESHOLD=60
FAKE_NEWS_MODEL_VERSION=fake-news-analyzer-v1.0

# Stolen Content & DMCA Monitoring Module
PHASH_SIMILARITY_THRESHOLD=90
CONTENT_CRAWL_TIMEOUT_MS=8000
DMCA_TEMPLATE_VERSION=v1
STOLEN_CONTENT_MODEL_VERSION=stolen-content-analyzer-v1.0

# Deepfake Detection Module
HIVE_MODERATION_API_KEY=
HIVE_MODERATION_API_URL=https://api.thehive.ai/api/v2
AWS_REKOGNITION_REGION=us-east-1
DEEPFAKE_CONFIDENCE_THRESHOLD=0.65
MAX_VIDEO_FRAMES_TO_ANALYZE=10
DEEPFAKE_MODEL_VERSION=deepfake-analyzer-v1.0

# Redis Cache Configuration
REDIS_TTL_SHORT=60
REDIS_TTL_MEDIUM=300
REDIS_TTL_LONG=3600
REDIS_TTL_DAY=86400
CACHE_ENABLED=true

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SKIP_TRUSTED_IPS=127.0.0.1,::1
API_KEY_RATE_LIMIT_PER_MIN=100
ABUSE_BAN_DURATION_HOURS=24
SUSPICIOUS_REQUEST_THRESHOLD=50

# Observability
LOG_LEVEL=info
CLOUDWATCH_LOG_GROUP=/truthshield/api
CLOUDWATCH_REGION=us-east-1
METRICS_ENABLED=true
METRICS_SECRET=super-secret-metrics-key
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=truthshield-api
OTEL_ENABLED=false

# Human Review Queue Configuration
HUMAN_REVIEW_SCORE_MIN=40
HUMAN_REVIEW_SCORE_MAX=70
HUMAN_REVIEW_SLA_HOURS=24
HUMAN_REVIEW_NOTIFICATION_EMAIL=review-team@truthshield.ai

# Database Hardening Configs
DATABASE_READ_URL=
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
SLOW_QUERY_THRESHOLD_MS=500
QUERY_LOG_ENABLED=false

# Dashboard Service Configs
DASHBOARD_CACHE_TTL=30
DASHBOARD_MAX_FEED_ITEMS=100
DASHBOARD_STATS_WINDOW_DAYS=30

# PDF Report Generation Configs
PDF_REPORT_BUCKET=truthshield-reports
PDF_GENERATION_TIMEOUT_MS=30000
REPORT_LOGO_S3_KEY=assets/logo.png
PDF_WATERMARK_TEXT=CONFIDENTIAL

# WebSocket Server Configurations
WEBSOCKET_ENABLED=true
WEBSOCKET_CORS_ORIGIN=
WEBSOCKET_HEARTBEAT_MS=25000
WEBSOCKET_TIMEOUT_MS=60000

# Billing & Subscription Management
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
BILLING_ENABLED=true

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/truthshield?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
TOTP_ISSUER=TruthShieldAI

# AWS S3 Storage Configs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PRESIGNED_URL_EXPIRY=3600
MAX_FILE_SIZE_IMAGE_MB=50
MAX_FILE_SIZE_VIDEO_MB=500

# Queue Configurations
QUEUE_CONCURRENCY=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY_MS=5000
BULL_BOARD_ENABLED=true
ADMIN_SECRET=admin-secret-key-12345

# Alert & Notification Service Configurations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@truthshield.ai
SLACK_WEBHOOK_URL=
ALERT_SCORE_THRESHOLD_LOW=25
ALERT_SCORE_THRESHOLD_MEDIUM=50
ALERT_SCORE_THRESHOLD_HIGH=75
ALERT_SCORE_THRESHOLD_CRITICAL=90

# Fake News & Misinformation Detection Module
ANTHROPIC_API_KEY=
GOOGLE_FACT_CHECK_API_KEY=
GOOGLE_FACT_CHECK_API_URL=https://factchecktools.googleapis.com/v1alpha1/claims:search
NEWS_CREDIBILITY_THRESHOLD=60
FAKE_NEWS_MODEL_VERSION=fake-news-analyzer-v1.0

# Stolen Content & DMCA Monitoring Module
PHASH_SIMILARITY_THRESHOLD=90
CONTENT_CRAWL_TIMEOUT_MS=8000
DMCA_TEMPLATE_VERSION=v1
STOLEN_CONTENT_MODEL_VERSION=stolen-content-analyzer-v1.0

# Deepfake Detection Module
HIVE_MODERATION_API_KEY=
HIVE_MODERATION_API_URL=https://api.thehive.ai/api/v2
AWS_REKOGNITION_REGION=us-east-1
DEEPFAKE_CONFIDENCE_THRESHOLD=0.65
MAX_VIDEO_FRAMES_TO_ANALYZE=10
DEEPFAKE_MODEL_VERSION=deepfake-analyzer-v1.0
